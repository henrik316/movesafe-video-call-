# Copy to .env and adjust. Local demo works with no file at all:
# staff login alex@movesaferelocation.com / walkthrough-demo

PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Required in production.
SESSION_SECRET=replace-with-a-long-random-string

# Local demo owner, used only when OWNER_EMAIL is not set and NODE_ENV is not production.
STAFF_EMAIL=alex@movesaferelocation.com
STAFF_NAME=Alex Rivera
STAFF_PASSWORD=walkthrough-demo

# Show the demo email and password on the login page. Defaults to true outside production.
SHOW_DEMO_BANNER=true

# Set true when the site is served over HTTPS.
COOKIE_SECURE=false

# Set true behind nginx, Fly, Render, Railway, or any TLS-terminating proxy.
TRUST_PROXY=false

# Where SQLite, local recordings, and posters are stored.
DATA_DIR=./data

# local (default) or s3. S3 is optional object storage for the finished files.
STORAGE=local
# S3_BUCKET=movesafe-recordings
# S3_REGION=us-east-1
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_FORCE_PATH_STYLE=false
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Delete finished recordings older than this many days. 0 keeps them until a person deletes them.
RECORDING_TTL_DAYS=0

# Transcode WebM recordings to MP4 when ffmpeg is installed (auto), never (off), or always try (mp4).
TRANSCODE=auto

# Owner account. In production this is the only account created automatically.
# Use a long password. It is stored as a hash and is not reset on later restarts
# unless OWNER_RESET_PASSWORD=true. The phone number is read from the environment
# only. The value below is a reserved example, not a real number.
# OWNER_EMAIL=henrik@example.com
# OWNER_NAME=Henrik Samuelsson
# OWNER_PASSWORD=replace-with-a-long-password
# OWNER_PHONE=+15555550100
# OWNER_RESET_PASSWORD=false

# Demo shared login is on outside production and off in production. Set false to
# disable it in dev too. Do not set DEMO_MODE in production.
# DEMO_MODE=true

# Vision inventory. Leave unset to use manual entry and the reference table only.
# Frames are sent to the provider only when this key is set.
# OPENAI_API_KEY=
# OPENAI_VISION_MODEL=gpt-4o-mini

# Texts to OWNER_PHONE for owner login and sensitive owner actions.
# Production refuses invites when these are missing.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# Optional email for staff invites. Without it, the owner copies the invite link.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=MoveSafe <desk@example.com>

# Optional TURN for customers and staff on strict networks (symmetric NAT, some mobile carriers).
# Without TURN, calls still work on normal home/office networks and on localhost.
# Time-limited credentials (coturn use-auth-secret / static-auth-secret):
# TURN_URLS=turn:video.movesaferelocation.com:3478?transport=udp,turn:video.movesaferelocation.com:3478?transport=tcp
# TURN_SECRET=same-value-as-coturn-static-auth-secret
# Or a static username and password:
# TURN_USERNAME=
# TURN_CREDENTIAL=
