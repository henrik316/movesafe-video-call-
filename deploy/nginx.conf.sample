# Reverse proxy for MoveSafe video.
# WebRTC media does not pass through nginx (it is peer-to-peer, or via TURN).
# This proxy only carries the site, signaling (WebSocket), and recording uploads.

server {
  listen 443 ssl http2;
  server_name video.movesaferelocation.com;

  # TLS certificates, for example from certbot.
  ssl_certificate     /etc/letsencrypt/live/video.movesaferelocation.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/video.movesaferelocation.com/privkey.pem;

  client_max_body_size 32m;

  location /socket.io/ {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 3600s;
  }

  location / {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 3600s;
  }
}
